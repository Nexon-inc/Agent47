# Agent47 Nginx Configuration Template
# This template can be used with environment variable substitution

user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
    use epoll;
    multi_accept on;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Logging format
    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for" '
                    'rt=$request_time uct="$upstream_connect_time" '
                    'uht="$upstream_header_time" urt="$upstream_response_time"';

    access_log /var/log/nginx/access.log main;

    # Basic settings
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;
    server_tokens off;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/json
        application/javascript
        application/xml+rss
        application/atom+xml
        image/svg+xml;

    # Rate limiting
    limit_req_zone $binary_remote_addr zone=api:10m rate=${API_RATE_LIMIT:-10}r/s;
    limit_req_zone $binary_remote_addr zone=login:10m rate=${LOGIN_RATE_LIMIT:-1}r/s;
    limit_req_zone $binary_remote_addr zone=general:10m rate=${GENERAL_RATE_LIMIT:-30}r/s;

    # Connection limiting
    limit_conn_zone $binary_remote_addr zone=conn_limit_per_ip:10m;

    # Upstream definitions
    upstream agent47_backend {
        least_conn;
        server ${BACKEND_HOST:-agent47-backend}:${BACKEND_PORT:-8000} max_fails=3 fail_timeout=30s;
        keepalive 32;
    }

    upstream agent47_frontend {
        least_conn;
        server ${FRONTEND_HOST:-agent47-frontend}:${FRONTEND_PORT:-3000} max_fails=3 fail_timeout=30s;
        keepalive 32;
    }

    upstream agent47_aria {
        least_conn;
        server ${ARIA_HOST:-agent47-aria}:${ARIA_PORT:-8001} max_fails=3 fail_timeout=30s;
        keepalive 16;
    }

    upstream agent47_clara {
        least_conn;
        server ${CLARA_HOST:-agent47-clara}:${CLARA_PORT:-8002} max_fails=3 fail_timeout=30s;
        keepalive 16;
    }

    upstream agent47_eric {
        least_conn;
        server ${ERIC_HOST:-agent47-eric}:${ERIC_PORT:-8003} max_fails=3 fail_timeout=30s;
        keepalive 16;
    }

    upstream agent47_jackie {
        least_conn;
        server ${JACKIE_HOST:-agent47-jackie}:${JACKIE_PORT:-8004} max_fails=3 fail_timeout=30s;
        keepalive 16;
    }

    upstream agent47_joe {
        least_conn;
        server ${JOE_HOST:-agent47-joe}:${JOE_PORT:-8005} max_fails=3 fail_timeout=30s;
        keepalive 16;
    }

    upstream agent47_purity {
        least_conn;
        server ${PURITY_HOST:-agent47-purity}:${PURITY_PORT:-8006} max_fails=3 fail_timeout=30s;
        keepalive 16;
    }

    upstream agent47_shakes {
        least_conn;
        server ${SHAKES_HOST:-agent47-shakes}:${SHAKES_PORT:-8007} max_fails=3 fail_timeout=30s;
        keepalive 16;
    }

    upstream grok_llm {
        least_conn;
        server ${GROK_HOST:-grok-llm}:${GROK_PORT:-8001} max_fails=3 fail_timeout=30s;
        keepalive 16;
    }

    upstream prometheus {
        server ${PROMETHEUS_HOST:-prometheus}:${PROMETHEUS_PORT:-9090};
    }

    upstream grafana {
        server ${GRAFANA_HOST:-grafana}:${GRAFANA_PORT:-3000};
    }

    # Security headers
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' wss: https:; frame-ancestors 'none';" always;

    # Main server block
    server {
        listen 80;
        server_name ${DOMAIN_NAME:-agent47.com} www.${DOMAIN_NAME:-agent47.com};
        
        # Redirect HTTP to HTTPS
        return 301 https://$server_name$request_uri;
    }

    # HTTPS server block
    server {
        listen 443 ssl http2;
        server_name ${DOMAIN_NAME:-agent47.com} www.${DOMAIN_NAME:-agent47.com};

        # SSL configuration
        ssl_certificate ${SSL_CERT_PATH:-/etc/nginx/ssl/agent47.crt};
        ssl_certificate_key ${SSL_KEY_PATH:-/etc/nginx/ssl/agent47.key};
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers ECDHE-RSA-AES256-GCM-SHA512:DHE-RSA-AES256-GCM-SHA512:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-SHA384;
        ssl_prefer_server_ciphers off;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 10m;
        ssl_stapling on;
        ssl_stapling_verify on;

        # Connection limits
        limit_conn conn_limit_per_ip ${CONN_LIMIT:-20};

        # Frontend
        location / {
            limit_req zone=general burst=${GENERAL_BURST:-50} nodelay;
            proxy_pass http://agent47_frontend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout ${PROXY_TIMEOUT:-30}s;
            proxy_send_timeout ${PROXY_TIMEOUT:-30}s;
            proxy_read_timeout ${PROXY_TIMEOUT:-30}s;
        }

        # API endpoints
        location /api/ {
            limit_req zone=api burst=${API_BURST:-20} nodelay;
            proxy_pass http://agent47_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout ${PROXY_TIMEOUT:-30}s;
            proxy_send_timeout ${PROXY_TIMEOUT:-30}s;
            proxy_read_timeout ${PROXY_TIMEOUT:-30}s;
        }

        # Agent endpoints
        location /api/agents/aria/ {
            limit_req zone=api burst=${AGENT_BURST:-10} nodelay;
            proxy_pass http://agent47_aria/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout ${PROXY_TIMEOUT:-30}s;
            proxy_send_timeout ${PROXY_TIMEOUT:-30}s;
            proxy_read_timeout ${PROXY_TIMEOUT:-30}s;
        }

        location /api/agents/clara/ {
            limit_req zone=api burst=${AGENT_BURST:-10} nodelay;
            proxy_pass http://agent47_clara/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout ${PROXY_TIMEOUT:-30}s;
            proxy_send_timeout ${PROXY_TIMEOUT:-30}s;
            proxy_read_timeout ${PROXY_TIMEOUT:-30}s;
        }

        location /api/agents/eric/ {
            limit_req zone=api burst=${AGENT_BURST:-10} nodelay;
            proxy_pass http://agent47_eric/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout ${PROXY_TIMEOUT:-30}s;
            proxy_send_timeout ${PROXY_TIMEOUT:-30}s;
            proxy_read_timeout ${PROXY_TIMEOUT:-30}s;
        }

        location /api/agents/jackie/ {
            limit_req zone=api burst=${AGENT_BURST:-10} nodelay;
            proxy_pass http://agent47_jackie/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout ${PROXY_TIMEOUT:-30}s;
            proxy_send_timeout ${PROXY_TIMEOUT:-30}s;
            proxy_read_timeout ${PROXY_TIMEOUT:-30}s;
        }

        location /api/agents/joe/ {
            limit_req zone=api burst=${AGENT_BURST:-10} nodelay;
            proxy_pass http://agent47_joe/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout ${PROXY_TIMEOUT:-30}s;
            proxy_send_timeout ${PROXY_TIMEOUT:-30}s;
            proxy_read_timeout ${PROXY_TIMEOUT:-30}s;
        }

        location /api/agents/purity/ {
            limit_req zone=api burst=${AGENT_BURST:-10} nodelay;
            proxy_pass http://agent47_purity/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout ${PROXY_TIMEOUT:-30}s;
            proxy_send_timeout ${PROXY_TIMEOUT:-30}s;
            proxy_read_timeout ${PROXY_TIMEOUT:-30}s;
        }

        location /api/agents/shakes/ {
            limit_req zone=api burst=${AGENT_BURST:-10} nodelay;
            proxy_pass http://agent47_shakes/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout ${PROXY_TIMEOUT:-30}s;
            proxy_send_timeout ${PROXY_TIMEOUT:-30}s;
            proxy_read_timeout ${PROXY_TIMEOUT:-30}s;
        }

        # Grok LLM endpoint
        location /api/grok/ {
            limit_req zone=api burst=${GROK_BURST:-5} nodelay;
            proxy_pass http://grok_llm/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout ${GROK_TIMEOUT:-60}s;
            proxy_send_timeout ${GROK_TIMEOUT:-60}s;
            proxy_read_timeout ${GROK_TIMEOUT:-60}s;
        }

        # WebSocket support
        location /ws/ {
            proxy_pass http://agent47_backend;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 86400;
        }

        # Health check endpoint
        location /health {
            access_log off;
            proxy_pass http://agent47_backend/health;
            proxy_set_header Host $host;
        }

        # Static files caching
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
            proxy_pass http://agent47_frontend;
        }
    }

    # Admin subdomain
    server {
        listen 443 ssl http2;
        server_name admin.${DOMAIN_NAME:-agent47.com};

        # SSL configuration (same as main)
        ssl_certificate ${SSL_CERT_PATH:-/etc/nginx/ssl/agent47.crt};
        ssl_certificate_key ${SSL_KEY_PATH:-/etc/nginx/ssl/agent47.key};
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers ECDHE-RSA-AES256-GCM-SHA512:DHE-RSA-AES256-GCM-SHA512:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-SHA384;
        ssl_prefer_server_ciphers off;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 10m;

        # Admin panel
        location / {
            limit_req zone=general burst=${ADMIN_BURST:-20} nodelay;
            proxy_pass http://agent47_frontend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Admin API
        location /api/admin/ {
            limit_req zone=api burst=${ADMIN_API_BURST:-10} nodelay;
            proxy_pass http://agent47_backend/api/admin/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }

    # API subdomain
    server {
        listen 443 ssl http2;
        server_name api.${DOMAIN_NAME:-agent47.com};

        # SSL configuration (same as main)
        ssl_certificate ${SSL_CERT_PATH:-/etc/nginx/ssl/agent47.crt};
        ssl_certificate_key ${SSL_KEY_PATH:-/etc/nginx/ssl/agent47.key};
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers ECDHE-RSA-AES256-GCM-SHA512:DHE-RSA-AES256-GCM-SHA512:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-SHA384;
        ssl_prefer_server_ciphers off;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 10m;

        # API endpoints
        location / {
            limit_req zone=api burst=${API_BURST:-50} nodelay;
            proxy_pass http://agent47_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }

    # Monitoring subdomain (internal only)
    server {
        listen 443 ssl http2;
        server_name monitoring.${DOMAIN_NAME:-agent47.com};

        # SSL configuration (same as main)
        ssl_certificate ${SSL_CERT_PATH:-/etc/nginx/ssl/agent47.crt};
        ssl_certificate_key ${SSL_KEY_PATH:-/etc/nginx/ssl/agent47.key};
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers ECDHE-RSA-AES256-GCM-SHA512:DHE-RSA-AES256-GCM-SHA512:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-SHA384;
        ssl_prefer_server_ciphers off;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 10m;

        # Restrict access to internal networks only
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;

        # Prometheus
        location /prometheus/ {
            proxy_pass http://prometheus/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Grafana
        location /grafana/ {
            proxy_pass http://grafana/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
