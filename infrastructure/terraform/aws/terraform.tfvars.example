# Agent47 AWS Terraform Variables Example
# Copy this file to terraform.tfvars and update the values

# AWS Configuration
aws_region  = "us-west-2"
aws_profile = "default"

# Project Configuration
project_name = "agent47"
environment  = "prod"  # dev, staging, prod

# VPC Configuration
vpc_cidr                = "10.0.0.0/16"
public_subnet_cidrs     = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs    = ["10.0.10.0/24", "10.0.20.0/24"]
public_access_cidrs     = ["0.0.0.0/0"]  # Restrict this in production

# Kubernetes Configuration
kubernetes_version = "1.28"
node_instance_type = "t3.medium"  # t3.small for dev, t3.large for prod
node_count         = 3
min_node_count     = 2
max_node_count     = 10

# Database Configuration
db_name                = "agent47_db"
db_username            = "agent47"
db_password            = "your_secure_password_here"  # Change this!
db_instance_class      = "db.t3.micro"  # db.t3.small for prod
db_allocated_storage   = 20
db_max_allocated_storage = 100
db_engine_version      = "15.4"

# Redis Configuration
redis_node_type        = "cache.t3.micro"  # cache.t3.small for prod
redis_num_cache_nodes  = 1

# Monitoring Configuration
log_retention_days = 7

# Backup Configuration
backup_retention_days = 7
