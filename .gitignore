# Important JSON/config files that should be tracked (exceptions - must come BEFORE *.json)
!**/package.json
!**/package-lock.json
!**/pnpm-lock.yaml
!**/tsconfig.json
!**/jsconfig.json
!**/next.config.mjs
!**/tailwind.config.ts
!**/postcss.config.mjs
!**/jest.config.js
!**/components.json
!**/.eslintrc.json
# Now ignore all other JSON files
*.json
*.jsonl
*.parquet
*.feather

